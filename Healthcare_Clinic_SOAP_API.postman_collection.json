    {
      "name": "Doctors - SOAP Integration",
      "item": [
        {
          "name": "Get Doctors from External SOAP Service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "description": "Fetches doctors from external SOAP web service with caching. Falls back to local DB if service fails.",
            "url": {
              "raw": "{{base_url}}/doctors/external",
              "host": ["{{base_url}}"],
              "path": ["doctors", "external"]
            }
          }
        },
        {
          "name": "Sync External SOAP Doctors to Local DB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "description": "Synchronizes doctors from external SOAP service to local database. Skips duplicates.",
            "url": {
              "raw": "{{base_url}}/doctors/sync-external",
              "host": ["{{base_url}}"],
              "path": ["doctors", "sync-external"]
            }
          }
        }
      ]
    },
